# Служебный .htaccess для деплой-веток (deploy/test, deploy/prod).
# CI кладёт этот файл в корень артефакт-ветки при публикации (см. DEPLOY.md).

# Страница 404 входит в сборку (404.html).
ErrorDocument 404 /404.html

# Хостинг клонирует репозиторий в папку сайта — не отдавать наружу служебные каталоги Git.
RedirectMatch 404 (?i)^/\.git
RedirectMatch 404 (?i)^/\.github
